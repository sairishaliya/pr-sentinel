{
  "name": "pr-sentinel",
  "version": "1.0.0",
  "description": "Reusable GitHub Action that reviews pull requests with Gemini or an offline mock reviewer and posts structured feedback back to the PR.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "clean": "rimraf dist lib",
    "build": "npm run clean && tsc && ncc build lib/index.js -o dist",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck",
    "verify": "npm run build && node lib/verify.js",
    "start:local": "tsc && node lib/index.js"
  },
  "keywords": [
    "github-action",
    "pull-request",
    "gemini",
    "offline-verification",
    "code-review"
  ],
  "author": "",
  "license": "MIT",
  "files": [
    "action.yml",
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@google/genai": "^2.10.0",
    "@octokit/rest": "^22.0.1",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vercel/ncc": "^0.44.1",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  }
}
